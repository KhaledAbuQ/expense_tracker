<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Top header row -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="POCKET EXPENSES"
            android:textColor="#818cf8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94a3b8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Stats section -->
    <LinearLayout
        android:id="@+id/widget_stats_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This month"
            android:textColor="#94a3b8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_month_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_default_month_total"
            android:textColor="#f8fafc"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_sub_stat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_default_sub_stat"
            android:textColor="#64748b"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Quick action button at bottom right -->
    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_add"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_button_bg"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/widget_btn_add"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</RelativeLayout>
