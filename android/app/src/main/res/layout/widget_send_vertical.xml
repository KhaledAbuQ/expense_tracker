<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/reference_widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/reference_widget_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="32dp" android:orientation="vertical">
  <TextView android:id="@+id/reference_widget_primary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Send" />
  <TextView android:id="@+id/reference_widget_secondary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Receive" />
 </LinearLayout>
</FrameLayout>
